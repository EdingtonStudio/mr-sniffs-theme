<section class="error-page">
  <img src="{{ 'mascot-white.svg' | asset_url }}" alt="" aria-hidden="true" class="error-page__mascot" width="96" height="96">
  <h1 class="error-page__headline">{{ 'general.password_page.opening_soon' | t }}</h1>
  {%- form 'storefront_password' -%}
    <label for="Password" class="newsletter-form__label">{{ 'general.password_page.login_form_password_label' | t }}</label>
    <div class="newsletter-form__row">
      <input
        id="Password"
        type="password"
        name="password"
        class="newsletter-form__input"
        placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
      >
      <button type="submit" class="newsletter-form__submit">{{ 'general.password_page.login_form_submit' | t }}</button>
    </div>
    {{ form.errors | default_errors }}
  {%- endform -%}
</section>
