<section class="narrow-page">
  <header class="narrow-page__header">
    <h1 class="narrow-page__title">{{ 'general.search.title' | t }}</h1>
  </header>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      aria-label="{{ 'general.search.placeholder' | t }}"
    >
    <button type="submit" class="newsletter-form__submit">{{ 'general.search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="narrow-page__body">{{ 'general.search.no_results' | t }}</p>
    {%- else -%}
      <ul class="search-results">
        {%- for item in search.results -%}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  {%- endif -%}
</section>
