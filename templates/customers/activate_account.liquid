<section class="narrow-page">
  <header class="narrow-page__header">
    <h1 class="narrow-page__title">Activate Account</h1>
  </header>
  <div class="narrow-page__body">
    {%- form 'activate_customer_password' -%}
      {{ form.errors | default_errors }}
      <label for="ActivatePassword" class="newsletter-form__label">Password</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="ActivatePassword" type="password" name="customer[password]" class="newsletter-form__input" autocomplete="new-password" required>
      </div>
      <label for="ActivatePasswordConfirm" class="newsletter-form__label">Confirm password</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" class="newsletter-form__input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn-loud">Activate</button>
    {%- endform -%}
  </div>
</section>
