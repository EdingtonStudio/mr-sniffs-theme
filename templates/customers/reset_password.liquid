<section class="narrow-page">
  <header class="narrow-page__header">
    <h1 class="narrow-page__title">Reset Password</h1>
  </header>
  <div class="narrow-page__body">
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <label for="ResetPassword" class="newsletter-form__label">New password</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="ResetPassword" type="password" name="customer[password]" class="newsletter-form__input" autocomplete="new-password" required>
      </div>
      <label for="ResetPasswordConfirm" class="newsletter-form__label">Confirm password</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" class="newsletter-form__input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn-loud">Reset Password</button>
    {%- endform -%}
  </div>
</section>
