<section class="narrow-page">
  <header class="narrow-page__header">
    <h1 class="narrow-page__title">Create Account</h1>
  </header>
  <div class="narrow-page__body">
    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}
      <label for="RegisterEmail" class="newsletter-form__label">Email</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="RegisterEmail" type="email" name="customer[email]" class="newsletter-form__input" autocomplete="email" required>
      </div>
      <label for="RegisterPassword" class="newsletter-form__label">Password</label>
      <div class="newsletter-form__row" style="margin-bottom: 1rem;">
        <input id="RegisterPassword" type="password" name="customer[password]" class="newsletter-form__input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn-loud">Create Account</button>
    {%- endform -%}
  </div>
</section>
